# Database
DATABASE_URL="postgresql://expense_tracker:dev_password@localhost:5432/expense_tracker_dev?schema=public"

# Test database (integration and e2e tests only; `npm run db:test:start`).
# Optional: tests fall back to this value when it is not set.
# TEST_DATABASE_URL="postgresql://expense_tracker:dev_password@localhost:5433/expense_tracker_test?schema=public"

# API
API_PORT=3001
API_URL="http://localhost:3001"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Exchange rates (ExchangeRate-API open access, no key)
EXCHANGE_RATES_URL="https://open.er-api.com/v6"

# Weather (Open-Meteo forecast and OpenStreetMap Nominatim geocoding, no keys)
WEATHER_URL="https://api.open-meteo.com/v1"
GEOCODING_URL="https://nominatim.openstreetmap.org"

# Production only (docs/deploy.md)
# Path the web app is served under; read by `next build`. Unset locally.
# NEXT_PUBLIC_BASE_PATH="/expense-tracker"
# Postgres password for docker/docker-compose.prod.yml (also put it in DATABASE_URL).
# POSTGRES_PASSWORD=""
# POSTGRES_DB="expense_tracker"
# Port `next start` listens on (ecosystem.config.cjs), default 3000.
# WEB_PORT=3000
