// The connection URL lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// Generated into the sources (gitignored) so `nest build` compiles it with
// the app; import it from `src/generated/prisma/client`.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless relative imports, so ts-jest resolves them to the .ts files.
  importFileExtension = ""
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  categories    Category[]
  tags          Tag[]
  transactions  Transaction[]
  refreshTokens RefreshToken[]
  settings      UserSettings?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

// One row per user, created on the first save; no row means the defaults.
// A JSON document so that new settings need no migration: the API validates
// it on write and falls back to the default for any key it can't read.
model UserSettings {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(50)
  color        String        @db.VarChar(7)
  icon         String        @db.VarChar(50)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

// A label the user puts on transactions. Transactions keep the ids in their
// `tagIds` JSON array, so there is no foreign key: deleting a tag strips its
// id from them, and readers ignore an id that names no tag.
model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2)
  // The ISO code `amount` was entered in (one of `CURRENCIES` in
  // @expense-tracker/types); conversion happens on read.
  currency    String          @default("EUR")
  type        TransactionType
  description String?
  date        DateTime
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // JSON array of the user's tag ids (at most `MAX_TAGS_PER_TRANSACTION`).
  tagIds      Json            @default("[]")
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([userId, date])
  @@index([categoryId])
  @@index([tagIds(ops: JsonbPathOps)], type: Gin)
  @@map("transactions")
}
